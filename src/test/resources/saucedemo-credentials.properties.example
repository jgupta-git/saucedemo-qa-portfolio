# Copy this file to saucedemo-credentials.properties (same folder) and fill in
# real values. saucedemo-credentials.properties is gitignored - only this
# .example template with placeholder values ever gets committed.
#
# Note: SauceDemo's credentials are publicly documented on its own login
# page (saucedemo.com), so nothing here is actually secret - this file
# exists to demonstrate the same "never hardcode test data" pattern used
# against real, sensitive credentials elsewhere in this portfolio.
saucedemo.username=standard_user
saucedemo.password=your-password-here

# Not secret, kept in the same file for convenience - override any of these
# per-run without editing the file, e.g.: mvn test -Dheadless=false -Dbrowser=firefox
base.url=https://www.saucedemo.com
browser=chromium
headless=true
